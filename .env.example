# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — bypasses RLS entirely. Server-only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude) — powers chat, copy generation, snippets, meeting
# summaries, freelancer matching, embargo checks, and the Biocartis/Expert assistants.
ANTHROPIC_API_KEY=

# Google Drive — general file storage (src/lib/drive-storage.ts).
# Service account needs at least "Content Manager" on the target Shared
# Drive; "Manager" is required for true permanent delete (see Phase 4).
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SPORTHOUSE_ROOT_FOLDER_ID=

# Google Drive — Pré-Assist submissions, separate root folder from the
# general client file storage above.
GOOGLE_PREASSIST_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PREASSIST_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PREASSIST_DRIVE_FOLDER_ID=

# Google Drive — native Google Docs/Sheets/Slides per client
# (src/lib/google-drive.ts, DriveManager.tsx). Separate service account
# from the two above; currently unconfigured/unused in production.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Asana — briefing-builder and content-planner "push to Asana" integrations
ASANA_PAT=
ASANA_WORKSPACE_GID=

# Google Analytics 4 — client analytics dashboard
GA4_PROPERTY_ID=
GA4_OAUTH_CLIENT_ID=
GA4_OAUTH_CLIENT_SECRET=
GA4_REFRESH_TOKEN=

# Meta (Facebook/Instagram) — used by the analytics/social integrations
META_APP_ACCESS_TOKEN=

# Web push notifications (VAPID keypair)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# App
NEXT_PUBLIC_SITE_URL=
# Shared secret required in the Authorization header for cron-triggered
# routes (e.g. api/cron/purge-trash) — must also be set in Vercel's
# production environment and in the scheduler calling these routes.
CRON_SECRET=
